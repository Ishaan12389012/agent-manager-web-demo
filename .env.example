# Copy this file to .env and fill in your own values.

# Your PostgreSQL connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/verdict

# Set to true for hosted databases that require SSL (Render, Railway, Neon, Supabase...).
DATABASE_SSL=false

# Any long random string. It signs the login cookie, so keep it secret.
SESSION_SECRET=replace-me-with-a-long-random-string

PORT=3000

# Optional: connects Ask Verdict to your Copilot Studio chatbot.
# Copilot Studio > Settings > Security > Web channel security > Secret 1. Keep it secret.
COPILOT_DIRECTLINE_SECRET=

# Optional: keep a spreadsheet in OneDrive or SharePoint in sync with the Data page.
# Paste the file's share link. Verdict checks it every EXCEL_SYNC_MINUTES and re-imports it when it changes.
EXCEL_SYNC_URL=
EXCEL_SYNC_MINUTES=5
# Optional: the file name to show on the Data page (it's read from OneDrive when left empty).
EXCEL_SYNC_NAME=
# Needed when the link isn't shared with "Anyone with the link": a Microsoft Entra app with the
# Microsoft Graph Files.Read.All application permission (admin consent granted).
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Optional: lets Power Automate (or a script) send a file to /api/import/push.
# Any long random string, at least 20 characters. Keep it secret.
IMPORT_API_KEY=
