# Copy this file to .env and fill in your own values.

# Your PostgreSQL connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/verdict

# Set to true for hosted databases that require SSL (Render, Railway, Neon, Supabase...).
DATABASE_SSL=false

# Any long random string. It signs the login cookie, so keep it secret.
SESSION_SECRET=replace-me-with-a-long-random-string

PORT=3000
